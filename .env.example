# Copy this file to .env and adjust values for the target environment.
LOG_LEVEL=INFO

CROP_OUTPUT_DIR=cropped_images
CROP_RETENTION_DAYS=30
CROP_CLEANUP_INTERVAL_SECONDS=3600

DOCUMENT_SESSION_TTL_SECONDS=900
MAX_DOCUMENT_SESSIONS=32

MAX_FRAME_SIZE_MB=10
MAX_FRAME_PIXELS=16000000

HOLOGRAM_SESSION_COOKIE=hologram_session
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
